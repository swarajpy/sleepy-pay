<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14172B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title"
            android:textColor="#EEF0FF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/tagline"
            android:textColor="#9AA0C8" />

        <!-- Step 1: choose payee -->
        <LinearLayout
            android:id="@+id/inputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1D2140"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/input_label"
                android:textColor="#9AA0C8" />

            <EditText
                android:id="@+id/manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/input_hint"
                android:inputType="textEmailAddress"
                android:textColor="#EEF0FF"
                android:textColorHint="#6B719C" />

            <Button
                android:id="@+id/useManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/continue_btn" />

            <Button
                android:id="@+id/scanBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_btn" />

            <TextView
                android:id="@+id/inputMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FF8A8A" />
        </LinearLayout>

        <!-- Step 2: payment details -->
        <LinearLayout
            android:id="@+id/payCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1D2140"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paying"
                android:textColor="#9AA0C8" />

            <TextView
                android:id="@+id/payeeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#EEF0FF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/payeeVpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9AA0C8" />

            <EditText
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/amount_hint"
                android:inputType="numberDecimal"
                android:textColor="#EEF0FF"
                android:textColorHint="#6B719C" />

            <Button
                android:id="@+id/copyVpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copy_id" />

            <Button
                android:id="@+id/copyAmt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copy_amount" />

            <TextView
                android:id="@+id/payMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#6EE7B7" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/steps"
                android:textColor="#EEF0FF" />

            <Button
                android:id="@+id/dialBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/open_ussd" />

            <Button
                android:id="@+id/resetBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_payment" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
